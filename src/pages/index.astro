---
import { loadPrices } from "../lib/prices";
import { renderBestHours, renderSaunaRows, type PricePoint } from "../lib/sauna";

const { points, errors, fetchedAt } = await loadPrices();

// Page metadata (paths respect the site's base path)
const base = import.meta.env.BASE_URL.replace(/\/$/, "") + "/";
const title = "Saunatime: cheapest time for a sauna";
const description =
  "Find the cheapest time to heat your sauna. See the average cost of a 1 to 6 hour session and the best hours, from Finnish spot electricity prices.";
const imageAlt =
  "Saunatime: a sauna stove with steam, and the text cheapest time for your sauna.";
const pageUrl = new URL(base, Astro.site).href;
const imageUrl = new URL(`${base}og-image.png`, Astro.site).href;

const DEFAULT_KW = 8;

// Best available hourly price (c/kWh incl. VAT): porssisahko.net, else Elering
const pricePoints: PricePoint[] = points.flatMap((p) => {
  const price = p.porssisahko ?? p.eleringCents;
  return price === null ? [] : [{ start: p.start.getTime(), price }];
});

const DEFAULT_HOURS = 2;
const buildTime = Date.now();
const saunaRows = renderSaunaRows(pricePoints, DEFAULT_KW, buildTime);
const bestHtml = renderBestHours(pricePoints, DEFAULT_KW, buildTime, DEFAULT_HOURS);

const updated = new Intl.DateTimeFormat("en-GB", {
  timeZone: "Europe/Helsinki",
  dateStyle: "medium",
  timeStyle: "short",
}).format(fetchedAt);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <meta name="robots" content="index, follow" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f7f7f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141413" media="(prefers-color-scheme: dark)" />

    <!-- PWA and icons -->
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${base}favicon-32.png`} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <meta name="application-name" content="Saunatime" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Saunatime" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Saunatime" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
  </head>
  <body>
    <main>
      <h1>Saunatime</h1>
      <p class="lead">
        Average cost of a sauna session, from Finnish spot electricity prices.
      </p>

      {
        errors.length > 0 && (
          <p class="notice" role="alert">
            Some price data failed to load: {errors.join("; ")}
          </p>
        )
      }

      <label class="power">
        Heater power
        <span class="field">
          <input
            id="kw"
            type="number"
            inputmode="decimal"
            min="1"
            max="30"
            step="0.5"
            value={DEFAULT_KW}
          />
          kW
        </span>
      </label>

      {
        pricePoints.length === 0 ? (
          <p class="notice">No price data available right now.</p>
        ) : (
          <>
            <section class="slide" aria-label="Best hours combined">
              <div class="slide-head">
                <span>Session length</span>
                <strong id="hours-out">{DEFAULT_HOURS} hours</strong>
              </div>
              <input
                id="hours"
                class="slider"
                type="range"
                min="1"
                max="6"
                step="1"
                value={DEFAULT_HOURS}
                aria-label="Session length in hours"
              />
              <div class="slide-scale"><span>1 h</span><span>6 h</span></div>
              <div id="best-hours" set:html={bestHtml} />
            </section>
            <ul class="sessions" id="sauna-rows" set:html={saunaRows} />
          </>
        )
      }

      <p class="note">
        Prices include VAT and assume the heater runs at full power the whole
        time. Cost is averaged over every possible start time from now on.
        Updated {updated} (Finland time).
      </p>
      <p class="note">
        Sources: <a href="https://porssisahko.net/">porssisahko.net</a> and
        <a href="https://dashboard.elering.ee/">Elering</a>.
      </p>
    </main>

    <script
      id="price-data"
      type="application/json"
      set:html={JSON.stringify(pricePoints)}
    />

    <script>
      import {
        buildSpeech,
        renderBestHours,
        renderSaunaRows,
        speechInfoFrom,
        type PricePoint,
      } from "../lib/sauna";

      const raw = document.getElementById("price-data")?.textContent;
      const prices: PricePoint[] = raw ? JSON.parse(raw) : [];
      const input = document.getElementById("kw") as HTMLInputElement | null;
      const slider = document.getElementById("hours") as HTMLInputElement | null;
      const hoursOut = document.getElementById("hours-out");
      const best = document.getElementById("best-hours");
      const list = document.getElementById("sauna-rows");

      // Remember choices between visits (storage can be unavailable)
      const load = (key: string) => {
        try {
          return Number(localStorage.getItem(key));
        } catch {
          return 0;
        }
      };
      const save = (key: string, value: number) => {
        try {
          localStorage.setItem(key, String(value));
        } catch {}
      };

      const update = () => {
        const kw = Number(input?.value);
        const hours = Number(slider?.value);
        const now = Date.now();
        if (hoursOut && hours > 0) {
          hoursOut.textContent = hours === 1 ? "1 hour" : `${hours} hours`;
        }
        if (!(kw > 0)) return;
        if (list) list.innerHTML = renderSaunaRows(prices, kw, now);
        if (best && hours > 0) best.innerHTML = renderBestHours(prices, kw, now, hours);
      };

      const savedKw = load("saunatime:kw");
      if (input && savedKw > 0 && savedKw <= 30) input.value = String(savedKw);
      const savedHours = load("saunatime:hours");
      if (slider && savedHours >= 1 && savedHours <= 6) slider.value = String(savedHours);

      input?.addEventListener("input", () => {
        const kw = Number(input.value);
        if (kw > 0) save("saunatime:kw", kw);
        update();
      });
      slider?.addEventListener("input", () => {
        save("saunatime:hours", Number(slider.value));
        update();
      });
      update();

      // Make the site installable and usable offline (production only)
      if (import.meta.env.PROD && "serviceWorker" in navigator) {
        navigator.serviceWorker.register("sw.js").catch(() => {});
      }

      // Text-to-speech: a fresh, funny message each tap (tap again to stop)
      const synth = "speechSynthesis" in window ? window.speechSynthesis : null;
      if (!synth) document.documentElement.classList.add("no-tts");

      document.addEventListener("click", (event) => {
        const btn = (event.target as HTMLElement).closest<HTMLButtonElement>("button.say");
        if (!btn || !synth) return;
        const wasSpeaking = btn.classList.contains("speaking");
        synth.cancel();
        document.querySelectorAll(".speaking").forEach((el) => el.classList.remove("speaking"));
        if (wasSpeaking) return;

        const utterance = new SpeechSynthesisUtterance(buildSpeech(speechInfoFrom(btn.dataset)));
        utterance.lang = "en-GB";
        utterance.rate = 0.95 + Math.random() * 0.2; // a little variety in delivery
        utterance.pitch = 0.9 + Math.random() * 0.3;
        utterance.onend = utterance.onerror = () => btn.classList.remove("speaking");
        btn.classList.add("speaking");
        synth.speak(utterance);
      });
    </script>

    <style is:global>
      :root {
        --bg: #f7f7f5;
        --fg: #1c1c1a;
        --muted: #5f5f5a;
        --card: #ffffff;
        --border: #dcdcd5;
        --accent: #1f6f43;
      }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) {
          --bg: #141413;
          --fg: #f1f1ed;
          --muted: #a5a59e;
          --card: #1f1f1d;
          --border: #34342f;
          --accent: #5cc98a;
        }
      }
      :root[data-theme="dark"] {
        --bg: #141413;
        --fg: #f1f1ed;
        --muted: #a5a59e;
        --card: #1f1f1d;
        --border: #34342f;
        --accent: #5cc98a;
      }

      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font: 20px/1.45 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      }
      main { max-width: 640px; margin: 0 auto; padding: 20px 16px 40px; }
      h1 { font-size: 2.6rem; line-height: 1.1; margin: 0.25rem 0 0.5rem; }
      .lead { color: var(--muted); margin: 0 0 1.5rem; }

      .power {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        font-weight: 600;
        margin-bottom: 1.25rem;
      }
      .field { display: inline-flex; align-items: center; gap: 8px; }
      .power input {
        width: 5.5rem;
        font: inherit;
        font-size: 1.6rem;
        font-weight: 700;
        text-align: center;
        padding: 8px;
        color: var(--fg);
        background: var(--card);
        border: 2px solid var(--border);
        border-radius: 12px;
      }

      .sessions { list-style: none; padding: 0; margin: 0; display: grid; gap: 14px; }
      .sessions li {
        display: grid;
        grid-template-columns: 1fr auto;
        align-items: baseline;
        gap: 2px 12px;
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 16px 18px;
      }
      .label { font-weight: 600; color: var(--muted); }
      .cost {
        font-size: 2.6rem;
        font-weight: 800;
        line-height: 1.1;
        color: var(--accent);
        font-variant-numeric: tabular-nums;
      }
      .best {
        grid-column: 1 / -1;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 10px;
        font-size: 0.9rem;
        color: var(--muted);
      }
      .say {
        font: inherit;
        font-size: 1rem;
        font-weight: 700;
        min-height: 48px;
        padding: 0 18px;
        color: var(--bg);
        background: var(--accent);
        border: 0;
        border-radius: 999px;
        cursor: pointer;
      }
      .say.speaking { outline: 3px solid var(--fg); }

      .slide {
        background: var(--card);
        border: 2px solid var(--accent);
        border-radius: 16px;
        padding: 16px 18px;
        margin-bottom: 14px;
      }
      .slide-head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 12px;
        font-weight: 600;
        color: var(--muted);
      }
      .slide-head strong { color: var(--fg); font-size: 1.7rem; white-space: nowrap; }
      .slider { width: 100%; height: 48px; margin: 6px 0 0; accent-color: var(--accent); }
      .slide-scale { display: flex; justify-content: space-between; font-size: 0.8rem; color: var(--muted); }
      .range { font-size: 1.25rem; font-weight: 700; margin-top: 12px; }
      .slide .cost { margin: 2px 0 10px; }
      .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 12px; }
      .chip { font-size: 0.85rem; padding: 4px 10px; border-radius: 999px; border: 1px solid var(--accent); }
      .chip.pricey { border-color: #d64545; color: #d64545; }
      .muted { color: var(--muted); }
      .no-tts .say { display: none; }

      .note { font-size: 0.8rem; color: var(--muted); margin: 1.5rem 0 0; }
      .notice {
        border-left: 4px solid #d64545;
        background: var(--card);
        padding: 10px 12px;
        border-radius: 8px;
        font-size: 0.9rem;
      }
      a { color: var(--accent); }
    </style>
  </body>
</html>
