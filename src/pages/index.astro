---
import { loadPrices } from "../lib/prices";
import { renderSaunaRows, type PricePoint } from "../lib/sauna";

const { points, errors, fetchedAt } = await loadPrices();

const DEFAULT_KW = 8;

// Best available hourly price (c/kWh incl. VAT): porssisahko.net, else Elering
const pricePoints: PricePoint[] = points.flatMap((p) => {
  const price = p.porssisahko ?? p.eleringCents;
  return price === null ? [] : [{ start: p.start.getTime(), price }];
});

const saunaRows = renderSaunaRows(pricePoints, DEFAULT_KW, Date.now());

const updated = new Intl.DateTimeFormat("en-GB", {
  timeZone: "Europe/Helsinki",
  dateStyle: "medium",
  timeStyle: "short",
}).format(fetchedAt);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Average cost of a sauna session in Finland, from spot electricity prices."
    />
    <title>Saunatime</title>
    <link rel="icon" href="data:," />
  </head>
  <body>
    <main>
      <h1>Saunatime</h1>
      <p class="lead">
        Average cost of a sauna session, from Finnish spot electricity prices.
      </p>

      {
        errors.length > 0 && (
          <p class="notice" role="alert">
            Some price data failed to load: {errors.join("; ")}
          </p>
        )
      }

      <label class="power">
        Heater power
        <span class="field">
          <input
            id="kw"
            type="number"
            inputmode="decimal"
            min="1"
            max="30"
            step="0.5"
            value={DEFAULT_KW}
          />
          kW
        </span>
      </label>

      {
        pricePoints.length === 0 ? (
          <p class="notice">No price data available right now.</p>
        ) : (
          <ul class="sessions" id="sauna-rows" set:html={saunaRows} />
        )
      }

      <p class="note">
        Prices include VAT and assume the heater runs at full power the whole
        time. Cost is averaged over every possible start time from now on.
        Updated {updated} (Finland time).
      </p>
      <p class="note">
        Sources: <a href="https://porssisahko.net/">porssisahko.net</a> and
        <a href="https://dashboard.elering.ee/">Elering</a>.
      </p>
    </main>

    <script
      id="price-data"
      type="application/json"
      set:html={JSON.stringify(pricePoints)}
    />

    <script>
      import { renderSaunaRows, type PricePoint } from "../lib/sauna";

      const raw = document.getElementById("price-data")?.textContent;
      const prices: PricePoint[] = raw ? JSON.parse(raw) : [];
      const input = document.getElementById("kw") as HTMLInputElement | null;
      const list = document.getElementById("sauna-rows");

      const update = () => {
        const kw = Number(input?.value);
        if (list && kw > 0) list.innerHTML = renderSaunaRows(prices, kw, Date.now());
      };

      input?.addEventListener("input", update);
      update();
    </script>

    <style is:global>
      :root {
        --bg: #f7f7f5;
        --fg: #1c1c1a;
        --muted: #5f5f5a;
        --card: #ffffff;
        --border: #dcdcd5;
        --accent: #1f6f43;
      }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) {
          --bg: #141413;
          --fg: #f1f1ed;
          --muted: #a5a59e;
          --card: #1f1f1d;
          --border: #34342f;
          --accent: #5cc98a;
        }
      }
      :root[data-theme="dark"] {
        --bg: #141413;
        --fg: #f1f1ed;
        --muted: #a5a59e;
        --card: #1f1f1d;
        --border: #34342f;
        --accent: #5cc98a;
      }

      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font: 20px/1.45 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      }
      main { max-width: 640px; margin: 0 auto; padding: 20px 16px 40px; }
      h1 { font-size: 2.6rem; line-height: 1.1; margin: 0.25rem 0 0.5rem; }
      .lead { color: var(--muted); margin: 0 0 1.5rem; }

      .power {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        font-weight: 600;
        margin-bottom: 1.25rem;
      }
      .field { display: inline-flex; align-items: center; gap: 8px; }
      .power input {
        width: 5.5rem;
        font: inherit;
        font-size: 1.6rem;
        font-weight: 700;
        text-align: center;
        padding: 8px;
        color: var(--fg);
        background: var(--card);
        border: 2px solid var(--border);
        border-radius: 12px;
      }

      .sessions { list-style: none; padding: 0; margin: 0; display: grid; gap: 14px; }
      .sessions li {
        display: grid;
        grid-template-columns: 1fr auto;
        align-items: baseline;
        gap: 2px 12px;
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 16px 18px;
      }
      .label { font-weight: 600; color: var(--muted); }
      .cost {
        font-size: 2.6rem;
        font-weight: 800;
        line-height: 1.1;
        color: var(--accent);
        font-variant-numeric: tabular-nums;
      }
      .best { grid-column: 1 / -1; font-size: 0.9rem; color: var(--muted); }

      .note { font-size: 0.8rem; color: var(--muted); margin: 1.5rem 0 0; }
      .notice {
        border-left: 4px solid #d64545;
        background: var(--card);
        padding: 10px 12px;
        border-radius: 8px;
        font-size: 0.9rem;
      }
      a { color: var(--accent); }
    </style>
  </body>
</html>
